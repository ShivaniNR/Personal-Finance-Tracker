# Supabase — same project as the web client (see client/.env).
# The anon key is public by design (RLS protects the data), so it is safe to
# expose in the app bundle, exactly like the web client's VITE_ vars.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI parsing endpoint (the server's /api/parse-transaction). Only used in Phase 5.
# NOTE: localhost only works on web / iOS simulator. On a physical device (Expo
# Go) or Android emulator, use your machine's LAN IP (e.g. http://192.168.1.50:4000)
# or the deployed server URL.
EXPO_PUBLIC_API_URL=http://localhost:4000
